Options -Indexes -MultiViews

RewriteEngine On

# Canonical production domain.
RewriteCond %{HTTP_HOST} ^www\.gamaservice\.fr$ [NC]
RewriteRule ^ https://gamaservice.fr%{REQUEST_URI} [R=301,L]

# Redirect the main domain to HTTPS once the OVH SSL certificate is active.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^gamaservice\.fr$ [NC]
RewriteRule ^ https://gamaservice.fr%{REQUEST_URI} [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Cache-Control "no-cache, must-revalidate" "expr=%{REQUEST_URI} =~ m#^/index\.html$#"
</IfModule>

